{
  "$schema": "https://assets.gtx.dev/config-schema.json",
  "framework": "next-app",
  "defaultLocale": "en",
  "locales": [
    "fr",
    "ja",
    "pt",
    "es"
  ],
  "description": "Databricks Developer Hub (developers.databricks.com): guides, tools, and best practices for building data apps and AI agents on Databricks. Keep product names (Databricks, AppKit, Lakebase, Unity Catalog, Genie, Mosaic AI, Databricks Apps) and code identifiers untranslated.",
  "files": {
    "gt": {
      "output": "public/_gt/[locale].json"
    },
    "mdx": {
      "include": [
        "src/content/docs/**/*.md",
        "src/content/docs/**/*.mdx",
        "src/content/recipes/**/*.md",
        "src/content/cookbooks/**/*.md",
        "src/content/examples/**/*.md",
        "src/content/solutions/**/*.md",
        "src/content/hackathon/*.md"
      ],
      "exclude": [
        "src/content/docs/appkit/**/api/**",
        "src/content/*/*/replit-prompt.md"
      ],
      "transform": {
        "match": "^src/content/",
        "replace": "src/content/{locale}/"
      }
    },
    "json": {
      "include": [
        "src/content/docs/**/meta.json"
      ],
      "exclude": [
        "src/content/docs/appkit/**"
      ],
      "transform": {
        "match": "^src/content/docs/",
        "replace": "src/content/{locale}/docs/"
      }
    }
  },
  "options": {
    "experimentalHideDefaultLocale": true,
    "skipFileValidation": {
      "mdx": true
    },
    "jsonSchema": {
      "src/content/docs/**/meta.json": {
        "include": [
          "$.title"
        ]
      }
    },
    "experimentalAddHeaderAnchorIds": "default"
  },
  "_versionId": "f6c09381f58e9a70fce05e44e22a13dc6ae0f12550a6f25d0820704d059d5ac4"
}